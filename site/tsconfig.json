{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strictNullChecks": false
  },
  "include": ["app.js", "ui.js", "vendor-types.d.ts"],
  "exclude": ["vendor", "tooling"]
}
